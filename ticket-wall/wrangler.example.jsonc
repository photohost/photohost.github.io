{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "harunoji-ticket-wall",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [
    { "binding": "DB", "database_name": "harunoji-ticket-wall", "database_id": "REPLACE_WITH_D1_ID" }
  ],
  "r2_buckets": [
    { "binding": "POSTERS", "bucket_name": "harunoji-ticket-posters" }
  ],
  "vars": {
    "TEAM_DOMAIN": "https://REPLACE_WITH_TEAM.cloudflareaccess.com",
    "POLICY_AUD": "REPLACE_WITH_ACCESS_AUD",
    "ADMIN_EMAIL": "REPLACE_WITH_YOUR_EMAIL"
  },
  "workers_dev": true,
  "preview_urls": false
}
